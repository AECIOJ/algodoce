{
  "name": "algodoce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "gen:theme": "python3 -m ajsystem.core.do_themes",
    "prebuild:css": "npm run gen:theme",
    "build:css": "postcss app/static/css/tailwind.src.css -o app/static/css/tailwind.css",
    "prewatch:css": "npm run gen:theme",
    "watch:css": "postcss app/static/css/tailwind.src.css -o app/static/css/tailwind.css --watch",
    "gen:theme:framework": "python3 -m ajsystem.core.do_themes --framework",
    "build:css:framework": "npm run gen:theme:framework && DAISYUI_THEMES=./app/ajsystem/tailwind.daisyui.framework.json postcss app/static/css/tailwind.src.css -o app/ajsystem/static/css/tailwind.css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.14",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0"
  }
}
